DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=db

JWT_SECRET=change-me

# Browser origins allowed to call the API (comma-separated). Defaults to the production
# domain; a local front started with `npm start` needs http://localhost:4200.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# create (recreates the schema on every startup, handy in dev) | validate | update | none
DDL_AUTO=create
# platform suffix Spring uses to pick data-${SQL_FILE}.sql (e.g. init -> data-init.sql).
# Use "init" for the full demo dataset (dev/CI), "prod" for data-prod.sql (admin account only, no demo data).
SQL_FILE=init
# always | never
SQL_INIT_MODE=always

# Plaintext passwords used once to hash the {seed-role} placeholders left in data-init.sql
# (see DemoPasswordSeeder). Leave unset once the demo accounts are seeded and hashed.
APP_SEED_DEMO_ADMIN_PASSWORD=
APP_SEED_DEMO_TECHNICIAN_PASSWORD=
APP_SEED_DEMO_DIRECTOR_PASSWORD=
APP_SEED_DEMO_MANAGER_PASSWORD=
APP_SEED_DEMO_CLIENT_PASSWORD=

# Public demo for a portfolio deploy: a "try it" button on the login page creates a trial
# technician account (rank 0, no personal data), purged with its data after APP_DEMO_TTL_HOURS.
# Never enable it on a real deployment.
APP_DEMO_ENABLED=false
APP_DEMO_TTL_HOURS=24
# Anti-abuse limits: trial accounts per IP per hour, tickets and comments per trial account per hour
APP_DEMO_MAX_ACCOUNTS_PER_IP=10
APP_DEMO_MAX_TICKETS_PER_HOUR=20
APP_DEMO_MAX_COMMENTS_PER_HOUR=20
